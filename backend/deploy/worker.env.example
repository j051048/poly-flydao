# Zeabur service 2: private Tenant Worker
# Root Directory: backend
# Health Check Path: /livez
# Do not attach a public domain. Keep one replica until load testing proves
# that additional workers are needed; database fencing remains the final gate.

PORT=8080
SERVICE_ROLE=worker
POLYBOT_COMPONENT=worker
POLYBOT_WORKER_EXECUTION_MODEL=tenant_queue
POLYBOT_MODE=paper
POLYBOT_LOG_LEVEL=INFO

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

POLYBOT_CREDENTIAL_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----
POLYBOT_CREDENTIAL_KEY_VERSION=1
POLYBOT_SIGNED_PAYLOAD_KEY=REPLACE_ME
POLYBOT_PAYLOAD_KEY_VERSION=1

POLYBOT_TENANT_WORKER_MAX_CONCURRENCY=4
POLYBOT_TENANT_JOB_LEASE_SECONDS=60
POLYBOT_TENANT_JOB_POLL_SECONDS=1
# Must match the API value when the allowlist is enabled.
# POLYBOT_CUSTOM_AI_ALLOWED_HOSTS=api.trusted-relay.example,*.gateway.example

# These explicit acknowledgements are still required before a tenant Canary or
# Live job can build a real-money runtime.
POLYBOT_LIVE_ACK=I_UNDERSTAND_REAL_FUNDS_CAN_BE_LOST
POLYBOT_BETA_SDK_ACK=I_ACCEPT_BETA_SDK_CANARY_ONLY
POLYBOT_DEDICATED_WALLET_ACK=I_CONFIRM_DEDICATED_WALLET_NO_EXTERNAL_FLOWS
POLYBOT_AUTO_REDEEM_RESOLVED=false

# Tenant wallet and AI secrets are encrypted through the API. Do not configure
# global POLYMARKET_PRIVATE_KEY, OPENAI_API_KEY, or LITELLM_API_KEY here.
