# Zeabur service 1: public Control API
# Root Directory: backend
# Health Check Path: /health

PORT=8080
SERVICE_ROLE=api
POLYBOT_COMPONENT=api
WEB_CONCURRENCY=1
POLYBOT_MODE=paper
POLYBOT_LOG_LEVEL=INFO

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

POLYBOT_DASHBOARD_ORIGINS=https://YOUR_VERCEL_DOMAIN
POLYBOT_CREDENTIAL_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----
POLYBOT_CREDENTIAL_KEY_VERSION=1
POLYBOT_CREDENTIAL_FINGERPRINT_KEY=REPLACE_ME

# Recommended before opening registration to strangers. Keep this identical on
# the worker and list the relay hosts you trust with tenant prompts/API keys.
# Leave unset during initial self-hosted testing to allow any validated public
# HTTPS OpenAI-compatible endpoint.
# POLYBOT_CUSTOM_AI_ALLOWED_HOSTS=api.trusted-relay.example,*.gateway.example

# Never add RSA private keys, wallet keys, AI keys, or signed-payload keys here.
