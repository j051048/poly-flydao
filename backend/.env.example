# Polybot backend template
#
# Deploy this directory as TWO Zeabur services from the same image:
#   API:    SERVICE_ROLE=api
#   Worker: SERVICE_ROLE=worker
#
# Never copy worker-only values into the public API service.

# ---------- Shared Supabase connection (API + Worker) ----------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Safe process defaults. The tenant queue reads account-specific mode, AI,
# wallet and risk references from Supabase.
POLYBOT_MODE=paper
POLYBOT_LOG_LEVEL=INFO
POLYBOT_GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYBOT_MIN_EVIDENCE_ITEMS=2

# Optional comma-separated exact/wildcard host allowlist for tenant-supplied,
# OpenAI-compatible relay URLs. Configure the same value on API and Worker.
# Empty still enforces HTTPS, public DNS/IP, no credentials/query/fragment,
# no redirects and no environment proxy; an allowlist is recommended for SaaS.
# POLYBOT_CUSTOM_AI_ALLOWED_HOSTS=api.trusted-relay.example,*.ai-gateway.example

# ---------- Public Zeabur API service only ----------
SERVICE_ROLE=api
POLYBOT_COMPONENT=api
POLYBOT_DASHBOARD_ORIGINS=https://your-dashboard.vercel.app

# Public half of the RSA credential envelope key. Generate the pair with:
#   uv run polybot generate-secrets
POLYBOT_CREDENTIAL_PUBLIC_KEY_PEM=
POLYBOT_CREDENTIAL_KEY_VERSION=1
POLYBOT_CREDENTIAL_FINGERPRINT_KEY=

# Supabase asymmetric JWT verification. The defaults are derived from
# SUPABASE_URL; set explicit values only when the project uses custom settings.
# POLYBOT_SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
# POLYBOT_SUPABASE_JWT_AUDIENCE=authenticated
# POLYBOT_SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# The API must NOT receive any of:
# POLYBOT_CREDENTIAL_PRIVATE_KEY_PEM
# POLYBOT_CREDENTIAL_PRIVATE_KEYS_JSON
# POLYBOT_SIGNED_PAYLOAD_KEY
# POLYMARKET_PRIVATE_KEY
# OPENAI_API_KEY
# LITELLM_API_KEY

# ---------- Private Zeabur Worker service only ----------
# Override the API values above in the separate Worker service:
# SERVICE_ROLE=worker
# POLYBOT_COMPONENT=worker
# POLYBOT_WORKER_EXECUTION_MODEL=tenant_queue
# POLYBOT_MODE=canary
# POLYBOT_TENANT_WORKER_MAX_CONCURRENCY=4
# POLYBOT_TENANT_JOB_LEASE_SECONDS=60
# POLYBOT_TENANT_JOB_POLL_SECONDS=1
# POLYBOT_RESOLUTION_POLL_SECONDS=300
# POLYBOT_CREDENTIAL_PRIVATE_KEY_PEM=
# POLYBOT_CREDENTIAL_KEY_VERSION=1
# POLYBOT_SIGNED_PAYLOAD_KEY=
# POLYBOT_PAYLOAD_KEY_VERSION=1
# POLYBOT_LIVE_ACK=I_UNDERSTAND_REAL_FUNDS_CAN_BE_LOST
# POLYBOT_BETA_SDK_ACK=I_ACCEPT_BETA_SDK_CANARY_ONLY
# POLYBOT_DEDICATED_WALLET_ACK=I_CONFIRM_DEDICATED_WALLET_NO_EXTERNAL_FLOWS
# POLYBOT_AUTO_REDEEM_RESOLVED=false
#
# Tenant AI keys and wallet private keys are encrypted through the API and
# decrypted only inside this Worker. Do not configure global OPENAI_API_KEY,
# LITELLM_API_KEY or POLYMARKET_PRIVATE_KEY in tenant_queue mode.

# Local paper-only development without Supabase is deliberately opt-in:
# POLYBOT_COMPONENT=all
# POLYBOT_MODE=paper
# POLYBOT_AI_PROVIDER=mock
# POLYBOT_ALLOW_INMEMORY_CONTROL=true
