# Safe defaults: no real order can be submitted with this file.
POLYBOT_MODE=paper
# Use api for the signer-free control service, worker for the isolated signer.
POLYBOT_COMPONENT=all
POLYBOT_ACCOUNT_ID=00000000-0000-0000-0000-000000000001
POLYBOT_BANKROLL_USD=1000
POLYBOT_AI_PROVIDER=mock
POLYBOT_EVIDENCE_PROVIDER=auto
POLYBOT_FORECAST_MODEL=gpt-5.6-terra
POLYBOT_CRITIC_MODEL=gpt-5.6-sol
POLYBOT_SCAN_INTERVAL_SECONDS=60
POLYBOT_RECONCILE_INTERVAL_SECONDS=30
POLYBOT_MARKET_LIMIT=20
POLYBOT_MAX_AI_MARKETS_PER_CYCLE=3
POLYBOT_AI_TIMEOUT_SECONDS=45
POLYBOT_FORECAST_COOLDOWN_SECONDS=900
POLYBOT_MIN_LIQUIDITY_USD=10000
POLYBOT_MIN_EDGE=0.04
POLYBOT_MIN_EVIDENCE_ITEMS=2
POLYBOT_MAX_ORDER_USD=5
POLYBOT_MAX_TRADE_RISK_PCT=0.005
POLYBOT_MAX_EVENT_EXPOSURE_PCT=0.02
POLYBOT_MAX_BUCKET_EXPOSURE_PCT=0.05
POLYBOT_MAX_GROSS_EXPOSURE_PCT=0.10
POLYBOT_DAILY_LOSS_LIMIT_PCT=0.02
POLYBOT_MAX_DRAWDOWN_PCT=0.08
POLYBOT_MAX_BOOK_AGE_SECONDS=5
POLYBOT_MIN_HOURS_TO_RESOLUTION=6

# AI: use OPENAI_API_KEY for direct OpenAI, or set provider=litellm and one
# OpenAI-compatible third-party/gateway key. In litellm mode, evidence=auto uses
# keyless GDELT Context same-sentence snippets (past 72h), so a second search
# key is not required. Resolution URLs and title-only leads do not count live.
OPENAI_API_KEY=
LITELLM_API_KEY=
# Remote gateways always require HTTPS; paper/shadow only allow HTTP for a
# loopback or single-label local/container service. Canary/live always require HTTPS.
POLYBOT_LITELLM_BASE_URL=http://litellm:4000/v1

# Supabase service-role credentials belong only on Zeabur workers/API, never Vercel/browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Live signer secrets belong only in the isolated Zeabur executor. Use a
# dedicated low-balance wallet with no manual/external trades. Send the one-time
# startup funding before first worker boot; later deposits, withdrawals and
# token transfers are outside the account ledger and are forbidden.
POLYMARKET_PRIVATE_KEY=
# Optional override. When blank, the official SDK derives and, if needed,
# deploys the signer's default Deposit Wallet. Run `polybot wallet-info`, send
# Polygon pUSD to the printed trading_wallet, then explicitly run
# `polybot wallet-bootstrap --confirm-standard-allowances` once.
POLYMARKET_DEPOSIT_WALLET=
POLYBOT_SIGNED_PAYLOAD_KEY=
POLYBOT_PAYLOAD_KEY_VERSION=1
POLYBOT_AUTO_REDEEM_RESOLVED=false

# Deliberately blank. Live additionally requires a short-lived DB arm and passing geoblock.
POLYBOT_LIVE_ACK=
POLYBOT_BETA_SDK_ACK=
# Canary/live signer workers require the exact acknowledgement documented in
# ../docs/DEPLOYMENT.md; keeping it blank preserves the safe default.
POLYBOT_DEDICATED_WALLET_ACK=
POLYBOT_ADMIN_TOKEN=
POLYBOT_DASHBOARD_ORIGINS=http://localhost:3000,https://your-dashboard.vercel.app
