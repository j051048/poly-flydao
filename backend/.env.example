# Polybot personal single-account template
# Recommended deployment: ONE Zeabur service, Root Directory = backend.

PORT=8080
SERVICE_ROLE=personal
WEB_CONCURRENCY=1
POLYBOT_MODE=paper
POLYBOT_PERSONAL_AUTO_RUN=true
POLYBOT_PERSONAL_LIVE_ENABLED=false
POLYBOT_LOG_LEVEL=INFO

# Supabase server-side connection. Never copy the service-role key to Vercel.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# The UUID in Supabase Dashboard > Authentication > Users for the sole owner.
POLYBOT_ACCOUNT_ID=REPLACE_WITH_SUPABASE_AUTH_USER_UUID

# Exact browser origins, comma separated, no path or trailing slash.
POLYBOT_DASHBOARD_ORIGINS=https://poly.example.com,https://YOUR_PROJECT.vercel.app

# Provider is inferred: Base URL means OpenAI-compatible; key-only means OpenAI.
POLYBOT_AI_API_KEY=REPLACE_ME
POLYBOT_AI_BASE_URL=https://api.example.com/v1
POLYBOT_AI_MODEL=REPLACE_WITH_MODEL_ID
# Optional ordered read-only fallback providers, comma-separated:
# POLYBOT_AI_FALLBACK_PROVIDERS=litellm,openai_compatible

# Dedicated low-balance EVM wallet only. Never use a main wallet or seed phrase.
POLYMARKET_PRIVATE_KEY=0xREPLACE_WITH_64_HEX_CHARACTERS
# Optional for a Polymarket proxy/funder wallet; omit for a direct EOA setup.
# POLYMARKET_DEPOSIT_WALLET=0xREPLACE_WITH_40_HEX_CHARACTERS

# Paper bankroll/risk defaults. Start small and tune only after reviewing results.
POLYBOT_BANKROLL_USD=100
POLYBOT_MAX_ORDER_USD=2

# ---------------------------------------------------------------------------
# Tuning knobs. Every value below is optional: the shown value is the built-in
# default, and the dashboard shows the effective numbers under /settings.
# ---------------------------------------------------------------------------

# Loop cadence and reconciliation (seconds).
# POLYBOT_SCAN_INTERVAL_SECONDS=60          # how often a cycle may start
# POLYBOT_RECONCILE_INTERVAL_SECONDS=30     # account/position reconciliation
# POLYBOT_FORECAST_COOLDOWN_SECONDS=900     # minimum age before re-forecasting
# POLYBOT_MAX_AI_MARKETS_PER_CYCLE=3        # AI spend cap per cycle

# Market universe. ``none`` keeps the liquidity-ranked top-N list.
# ``crypto_updown`` restricts every cycle to short-horizon crypto Up/Down
# windows (BTC 5-minute markets by default) before forecasting.
# POLYBOT_MARKET_FILTER=none
# POLYBOT_CRYPTO_UPDOWN_ASSETS=BTC,ETH      # BTC/ETH/SOL/XRP only

# AI reliability calibration and spend guards.
# POLYBOT_CALIBRATION_REFRESH_SECONDS=900   # how often the reliability curve reloads
# POLYBOT_AI_CYCLE_UNITS_ALERT=10           # per-cycle AI request alert threshold
# POLYBOT_AI_CYCLE_COST_ALERT_USD=0.50      # per-cycle estimated cost alert
# The daily AI request budget itself is stored per account (ai_budget_settings)
# and enforced before every provider call: an exhausted budget is a hard stop,
# never an after-the-fact report.

# Bounded-growth retention for ai_usage_ledger / equity_history / snapshots.
# Only those three append-only history tables are pruned, in bounded batches;
# orders, fills, forecasts, positions and the reconciliation ledger are the
# real-money audit trail and are never deleted. Windows have hard minimums.
# POLYBOT_RETENTION_ENABLED=true
# POLYBOT_RETENTION_AI_USAGE_DAYS=90        # minimum 7
# POLYBOT_RETENTION_EQUITY_HISTORY_DAYS=365 # minimum 30
# POLYBOT_RETENTION_SNAPSHOT_DAYS=30        # minimum 1
# POLYBOT_RETENTION_INTERVAL_SECONDS=86400  # minimum 3600

# External liveness monitor: while the worker stays not-ready for longer than
# this, one alert per outage is pushed to POLYBOT_NOTIFY_WEBHOOK_URL (repeated
# at most every 6 hours, plus one message when it recovers).
# POLYBOT_READINESS_ALERT_SECONDS=900

# Advanced sizing/edge and platform knobs (defaults shown).
# POLYBOT_MIN_EDGE=0.04                     # minimum net edge to consider a trade
# POLYBOT_MIN_FORECAST_CONFIDENCE=0.55
# POLYBOT_MAX_TRADE_RISK_PCT=0.005          # per-trade equity risk
# POLYBOT_MAX_EVENT_EXPOSURE_PCT=0.02
# POLYBOT_MAX_GROSS_EXPOSURE_PCT=0.10
# POLYBOT_DAILY_LOSS_LIMIT_PCT=0.02
# POLYBOT_MAX_DRAWDOWN_PCT=0.08
# POLYBOT_MARKET_LIMIT=20                   # markets scanned per cycle
# POLYBOT_RESOLUTION_POLL_SECONDS=300       # resolved-market polling
# POLYBOT_AI_TIMEOUT_SECONDS=45
# POLYBOT_SUPABASE_TIMEOUT_SECONDS=15       # fail fast instead of freezing a cycle
# POLYBOT_API_HOST=0.0.0.0
# POLYBOT_EVIDENCE_PROVIDER=auto            # auto|openai_web|gdelt|none
# POLYBOT_CRITIC_MODEL=                     # optional second-opinion model

# The three acknowledgement strings below belong to the non-personal (legacy
# multi-tenant) live path only; personal mode opts in through
# POLYBOT_PERSONAL_LIVE_ENABLED plus the dashboard arm instead. They are listed
# so the requirement is discoverable, not so they encourage shared deployments:
# POLYBOT_LIVE_ACK=I_UNDERSTAND_REAL_FUNDS_CAN_BE_LOST
# POLYBOT_BETA_SDK_ACK=I_ACCEPT_BETA_SDK_CANARY_ONLY
# POLYBOT_DEDICATED_WALLET_ACK=I_CONFIRM_DEDICATED_WALLET_NO_EXTERNAL_FLOWS

# Liquidity and evidence gates.
# POLYBOT_MIN_LIQUIDITY_USD=10000           # skip thin markets
# POLYBOT_MIN_EVIDENCE_ITEMS=2              # must stay >=2 in canary/live
# POLYBOT_MIN_HOURS_TO_RESOLUTION=6
# POLYBOT_MAX_BOOK_AGE_SECONDS=5            # live executor order-book freshness

# Sizing and uncertainty.
# POLYBOT_KELLY_FRACTION=0.25               # fraction of full Kelly
# POLYBOT_UNCERTAINTY_RESERVE=0.01          # edge haircut
# POLYBOT_MAX_BUCKET_EXPOSURE_PCT=0.05

# Redeem resolved winners back into the wallet automatically. Requires an armed
# runtime, a healthy worker lease and a passing geoblock check on every attempt.
# POLYBOT_AUTO_REDEEM_RESOLVED=true

# Must remain the official endpoint; canary/live refuse to start otherwise.
# POLYBOT_GEOBLOCK_URL=https://polymarket.com/api/geoblock

# Ignore everything this wallet did before the given instant (ISO-8601 UTC).
# Prefer the dashboard action "重置对账基准" over this variable: it applies
# without a redeploy and is refused while the runtime is armed.
# POLYBOT_RECONCILE_BASELINE_UTC=2026-09-21T00:00:00Z

# Read-only market archive: full L2 books are persisted for future backtests.
POLYBOT_ARCHIVE_ENABLED=true
POLYBOT_ARCHIVE_MARKET_LIMIT=20
POLYBOT_ARCHIVE_INTERVAL_SECONDS=300

# Optional external alerts (Telegram/Discord-compatible webhook). Omit to disable.
# POLYBOT_NOTIFY_WEBHOOK_URL=https://hooks.example.com/your-endpoint

# Canary/Live is deliberately disabled in this template. To opt in, set
# POLYBOT_PERSONAL_LIVE_ENABLED=true and restart once; afterwards paper, shadow,
# canary and live are switched from the dashboard with no redeploy. Keep
# POLYBOT_MODE=paper so the process always boots in the safe mode, and treat
# POLYBOT_PERSONAL_LIVE_ENABLED as the single deployment-level capability switch:
# POLYBOT_PERSONAL_LIVE_ENABLED=true
# POLYBOT_MODE=paper

# Do not add NEXT_PUBLIC_*, PASSWORD, POLYBOT_ADMIN_TOKEN, credential RSA keys,
# credential fingerprint keys, or POLYBOT_SIGNED_PAYLOAD_KEY to personal mode.
