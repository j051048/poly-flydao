# Polybot personal single-account template
# Recommended deployment: ONE Zeabur service, Root Directory = backend.

PORT=8080
SERVICE_ROLE=personal
WEB_CONCURRENCY=1
POLYBOT_MODE=paper
POLYBOT_PERSONAL_AUTO_RUN=true
POLYBOT_PERSONAL_LIVE_ENABLED=false
POLYBOT_LOG_LEVEL=INFO

# Supabase server-side connection. Never copy the service-role key to Vercel.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# The UUID in Supabase Dashboard > Authentication > Users for the sole owner.
POLYBOT_ACCOUNT_ID=REPLACE_WITH_SUPABASE_AUTH_USER_UUID

# Exact browser origins, comma separated, no path or trailing slash.
POLYBOT_DASHBOARD_ORIGINS=https://poly.example.com,https://YOUR_PROJECT.vercel.app

# Provider is inferred: Base URL means OpenAI-compatible; key-only means OpenAI.
POLYBOT_AI_API_KEY=REPLACE_ME
POLYBOT_AI_BASE_URL=https://api.example.com/v1
POLYBOT_AI_MODEL=REPLACE_WITH_MODEL_ID
# Optional ordered read-only fallback providers, comma-separated:
# POLYBOT_AI_FALLBACK_PROVIDERS=litellm,openai_compatible

# Dedicated low-balance EVM wallet only. Never use a main wallet or seed phrase.
POLYMARKET_PRIVATE_KEY=0xREPLACE_WITH_64_HEX_CHARACTERS
# Optional for a Polymarket proxy/funder wallet; omit for a direct EOA setup.
# POLYMARKET_DEPOSIT_WALLET=0xREPLACE_WITH_40_HEX_CHARACTERS

# Paper bankroll/risk defaults. Start small and tune only after reviewing results.
POLYBOT_BANKROLL_USD=100
POLYBOT_MAX_ORDER_USD=2

# Read-only market archive: full L2 books are persisted for future backtests.
POLYBOT_ARCHIVE_ENABLED=true
POLYBOT_ARCHIVE_MARKET_LIMIT=20
POLYBOT_ARCHIVE_INTERVAL_SECONDS=300

# Optional external alerts (Telegram/Discord-compatible webhook). Omit to disable.
# POLYBOT_NOTIFY_WEBHOOK_URL=https://hooks.example.com/your-endpoint

# Canary/Live is deliberately disabled in this template. To opt in, change BOTH:
# POLYBOT_PERSONAL_LIVE_ENABLED=true
# POLYBOT_MODE=canary

# Do not add NEXT_PUBLIC_*, PASSWORD, POLYBOT_ADMIN_TOKEN, credential RSA keys,
# credential fingerprint keys, or POLYBOT_SIGNED_PAYLOAD_KEY to personal mode.
