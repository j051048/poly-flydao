# Browser-visible HTTPS URL of the Zeabur control API. Production fails closed
# when omitted; loopback HTTP is accepted only by the development server.
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example

# Supabase Auth public browser configuration. Either a publishable key or the
# legacy anon key is accepted. The app safely disables Auth when these values
# are absent, so `next build` does not require production credentials.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_REPLACE_ME

# Never put any of the following in this Vercel app:
# - SUPABASE_SERVICE_ROLE_KEY
# - EVM private keys or seed phrases
# - AI provider keys
# - Polymarket CLOB credentials
# - shared administrator tokens
#
# Tenant secrets are submitted once after login to the Zeabur credential
# endpoint and stored by the backend's Vault/KMS boundary.
