# Browser-visible URL of the Zeabur control API. Production must use HTTPS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Never put POLYBOT_ADMIN_TOKEN, a wallet private key, CLOB credentials,
# Supabase service-role keys, seed phrases, or signing payloads in this Vercel app.
# The admin token is entered manually and kept only in current-page React memory.

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
