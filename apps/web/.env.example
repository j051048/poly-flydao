# Vercel: the public HTTPS origin of the ONE Zeabur personal service.
NEXT_PUBLIC_API_BASE_URL=https://YOUR_SERVICE.zeabur.app

# Vercel: public Supabase Auth browser configuration.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy projects may use this instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ_REPLACE_ME

# These are the only variables needed by the Vercel app. Never add:
# - SUPABASE_SERVICE_ROLE_KEY
# - POLYBOT_AI_API_KEY or any provider API key
# - POLYMARKET_PRIVATE_KEY, seed phrases or CLOB credentials
# - PASSWORD, POLYBOT_ADMIN_TOKEN or credential RSA/fingerprint keys
#
# AI and wallet secrets belong only to the Zeabur personal service.
